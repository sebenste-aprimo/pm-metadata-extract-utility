{
  // Aprimo PM (Productivity & Spend) CSV export - shipped defaults.
  // Comments are allowed: the loader is configured to skip them.
  //
  // DO NOT put your own settings in this file. It ships with the tool and stays generic.
  // Put your tenant, and anything else you want to change, in appsettings.local.json -
  // see appsettings.local.example.json. That file is layered over this one, replaces only
  // the settings it names, is never shipped, and survives a rebuild.
  //
  // Precedence: this file < appsettings.local.json < environment variables < command line.

  "Aprimo": {
    // Subdomain of your Aprimo URL. Derives both endpoints below:
    //   API   -> https://{tenant}.aprimo.com/api
    //   Token -> https://{tenant}.aprimo.com/login/connect/token
    //
    // Note the API host differs from the DAM API's: PM is on the plain tenant host under
    // /api, while DAM is {tenant}.dam.aprimo.com/api/core. The token endpoint is the
    // same for both, so one registration's credentials work for either - provided the
    // registration is granted the 'api' scope.
    //
    // REQUIRED, and deliberately blank here: set it in appsettings.local.json, or pass
    // --tenant. If your environment uses different hosts (a sandbox or a regional
    // deployment, say), set ApiBaseUrl and TokenUrl explicitly instead.
    //
    // To confirm the derived endpoints, fetch the tenant's OpenID discovery document,
    // which is public and unauthenticated:
    //   https://{tenant}.aprimo.com/login/.well-known/openid-configuration
    // It lists the real token_endpoint, the supported grant types and the scopes.
    "Tenant": "",

    // Set these via APRIMO_CLIENT_ID / APRIMO_CLIENT_SECRET instead of committing them.
    "ClientId": "",
    "ClientSecret": "",

    // The spec lists three scopes: api, reporting-api, filestore-access.
    // A metadata export needs 'api'.
    "Scope": "api",
    "ClientAuthStyle": "Basic",

    // Renew this many seconds before expiry. Must exceed Source.RequestTimeoutSeconds
    // (120), or a request can outlive its own token.
    "RefreshSkewSeconds": 180,

    // null = not sent. The DAM API mandates an API-VERSION header; the PM spec declares
    // no header parameters on any of its 288 paths, so sending one is a guess. Set it to
    // "1" only if your tenant turns out to want it.
    "ApiVersion": null,

    // Extra headers on every API request. Normally empty.
    "AdditionalHeaders": {}
  },

  // Which objects to export. A comma-separated list of names from objects.json, or
  // "all". Run --list-objects to see them. Override per run with --objects.
  "Objects": "all",

  // The object registry. Resolved relative to the current directory, then beside this
  // config file, then beside the executable.
  "ObjectsFile": "objects.json",

  // One column list per object, named {object}.txt. Generate them with:
  //   aprimo-pm-export --all-objects --discover-fields
  //
  // Unlike the DAM utility's single fields.txt, there has to be one file per object:
  // PM's objects share almost no properties, so a single list would be wrong for all of
  // them at once.
  "FieldsDirectory": "fields",

  // Used for objects with no file of their own.
  "DefaultFieldsFile": "_default.txt",

  // With no column list at all, derive columns from the first item returned. Handy for a
  // first look; not stable enough for a recurring job, because an attribute nobody
  // filled in on page 1 produces no column. Use --discover-fields to pin them down.
  "AutoDeriveColumns": true,

  "Source": {
    // Applied to every object, overriding each object's own default sort. Normally null:
    // the objects have unrelated schemas, so one shared sort key rarely fits them all.
    "SortField": null,

    // The API takes a separate sortAscending boolean, not DAM's "-Field" prefix.
    // Ascending is safer for a long export: with descending order, newly modified items
    // jump to page 1 and shift every offset behind them.
    "SortAscending": true,

    // Fail on page 1 if the response is not the expected HAL envelope, or if items lack
    // the object's IdProperty, rather than writing a file full of blanks.
    "VerifyShapeOnFirstPage": true,

    // Fetch each item's full representation from its DetailPath after listing it.
    // Expensive - one request per item instead of one per page. Only worth it if a
    // collection response turns out to omit properties the single-item endpoint returns.
    "HydrateFromDetailEndpoint": false,

    "Paging": {
      // Offset     -> offset/limit, advancing by the number of items returned
      // LinkFollow -> follow _links.next.href from the HAL envelope
      //
      // There is no keyset mode here, unlike the DAM utility: PM has no query language
      // in which a watermark predicate could be expressed.
      "Mode": "Offset",

      // The spec's declared default is 50 and it documents NO maximum - unlike the DAM
      // API, whose RecordCollection.limit carries maximum:1000. So there is no published
      // ceiling to aim at. 100 is deliberately conservative; raise it once a tenant is
      // shown to accept more.
      "PageSize": 100,

      "MaxPages": 0,

      // Fails an object if paging passes this offset without finishing. Catches an
      // endpoint that ignores 'offset' and would otherwise return page 1 forever.
      // 0 disables the guard.
      "MaxOffset": 1000000
    },

    // Incremental export. Drive it with --daily (= --since last) or --since <spec>.
    "Delta": {
      // SortedDescending -> sort newest-first and stop once rows fall before the window.
      //                     Cheap for a daily delta, and verified: if the API turns out
      //                     not to honour sortField, the early stop is withdrawn.
      // FullScan         -> read the whole collection every run and filter locally.
      //                     Always correct, never cheap.
      "Strategy": "SortedDescending",

      // Compared property, overriding each object's own ModifiedProperty. Normally null,
      // since the objects do not agree on a single name.
      "Property": null,

      // Require positive evidence of descending order before allowing an early stop.
      // Leave this on: the sort IS the stopping rule here, so a silently ignored
      // sortField would truncate the export rather than merely slow it down.
      "SortVerification": true,

      // Minutes of deliberate re-read when resuming, to absorb clock skew between the
      // API's timestamps and our own. Costs a few duplicate rows per run; the
      // alternative is silently dropping items. Set 0 for exact adjacency.
      "OverlapMinutes": 5,

      // High-water mark file, relative to Output.Directory. Keyed by tenant + object, so
      // a run covering a subset never disturbs the marks of the objects it skipped.
      "StateFile": "delta-state.json",

      "WarnIfWindowExceedsDays": 7,

      // Objects with no modified-date property cannot be windowed. Skipping them is the
      // honest default: exporting them in full would mix a complete snapshot into what
      // the file names describe as a delta.
      "SkipObjectsWithoutModifiedProperty": true
    },

    "Retry": {
      "MaxAttempts": 5,
      "InitialBackoffSeconds": 1.0,
      "MaxBackoffSeconds": 60.0,
      "BackoffMultiplier": 2.0,
      "RespectRetryAfter": true
    },

    "RequestTimeoutSeconds": 120
  },

  "Throttle": {
    // Requests per second. Fractional allowed (0.5 = one request every 2s). 0 = unlimited.
    // One limiter is shared across every object, so a 24-object run stays inside the same
    // ceiling as a single-object one.
    "RequestsPerSecond": 5.0,

    // Token-bucket depth: how many requests may fire back-to-back. 1 = even spacing.
    "Burst": 1,

    "MaxConcurrentRequests": 1
  },

  "Output": {
    "Directory": "./export",

    // Files land as {FilePrefix}-{object}_0001.csv. The object name is always in the
    // name, because one run writes a separate set per object.
    "FilePrefix": "aprimo-pm",

    "SubdirectoryPerObject": false,

    "Delimiter": ",",
    "WriteByteOrderMark": true,
    "NewLine": "CRLF",
    "MultiValueSeparator": "|",
    "NewlineInValue": "Separator",
    "SanitizeFormulas": true,
    "WriteBufferBytes": 1048576,
    "Overwrite": false,

    // manifest.csv: one row per object with rows, files, requests, elapsed and outcome.
    // With two dozen objects in a run, the console summary is too long to rely on, and a
    // downstream job can assert against this before loading anything.
    "WriteManifest": true,

    // Resolve "label:" columns against the tenant's lookup lists, so projectStatus 4
    // exports as "Closed" rather than 4.
    //
    // Costs one request per distinct list referenced by the column list, fetched once
    // per object and reused for every row. Which list a field uses comes from
    // GET /metadata/{resourceName}, so a field added to the tenant later resolves with
    // no code change.
    //
    // Turning this off leaves those columns holding raw codes rather than removing them,
    // so a file's column set never changes.
    "ResolveLookups": true,

    // Resolve "user:" columns (projectManager, modifiedUser, ...) to "Last, First" names.
    //
    // This is separate from ResolveLookups because the lookup list behind user fields was
    // unusable on the tenant this was developed against: it held 600 entries sorted
    // alphabetically, so everyone from roughly D to Z was missing, and it listed active users
    // only. GET /users/{id} resolved every user tried, inactive ones included. Your tenant
    // may differ; --probe-users tells you.
    //
    // Costs one request per DISTINCT user, cached for the whole run and shared across
    // objects. Each response is a full user record (email, phone, address) held in memory to
    // read two name fields; only the formatted name is kept, nothing else is written or logged.
    //
    // Off leaves those columns holding the numeric ID, so the column set never changes.
    "ResolveUsers": true,

    // Properties whose values are user IDs, so --discover-fields writes a user: column for
    // them. Nothing in the API says which integers are users, so extend this for your tenant.
    // It only affects generation; a user: path in a hand-written column list works regardless.
    "UserFields": [
      "projectManager", "modifiedUser", "modifiedUserId", "ownerId", "administratorId",
      "creatorId", "completedByUser", "reviewedBy", "purgedBy", "modifiedBy", "createdBy"
    ],

    // When --discover-fields meets a coded field, write both the code column and a
    // "<Name>Label" column. The label is what a person reads; the code is what joins to
    // other systems and what survives the label being renamed. Delete whichever you do
    // not want - the generated file is meant to be edited.
    "GenerateCodeAndLabelColumns": true
  },

  "Limits": {
    // Rows per CSV file before rolling to the next part. 0 = never roll.
    "MaxRecordsPerFile": 1000000,

    // Row cap PER OBJECT, not across the run. 0 = unlimited. Per-object is the useful
    // meaning when one run covers two dozen collections: a shared cap would be spent
    // entirely on whichever object happened to go first.
    "MaxRecordsPerObject": 0,

    "EnableCheckpoint": true,

    // Drop an item whose ID was already written in this run. On by default, unlike the
    // DAM utility: offset paging over a collection someone else is editing will re-show
    // items as rows shift between pages, and PM has no immutable-watermark paging mode
    // to fall back on.
    "DeduplicateById": true,

    // Ceiling on tracked IDs before de-duplication turns itself off for that object.
    // Duplicates are fixable downstream; an out-of-memory failure halfway through a
    // multi-hour run is not.
    "MaxDeduplicationIds": 2000000,

    // Keep going when one object fails. An unlicensed or permission-denied collection is
    // a normal outcome across a two-dozen-object registry and should not throw away the
    // exports that worked. The process exits 4 when this happens.
    "ContinueOnObjectFailure": true
  }
}
