{
  // Your settings for the Aprimo PM export utility.
  //
  // To use this file:
  //   1. Copy it to  appsettings.local.json  in the directory you run the tool from
  //      (normally this project's root).
  //   2. Replace the tenant below, and keep only the settings you actually want to change.
  //
  // appsettings.local.json is layered over the shipped appsettings.json. It replaces only
  // the settings it names - everything else keeps its default - and it is never shipped,
  // never committed (see .gitignore), and survives a rebuild.
  //
  // Precedence, lowest to highest:
  //   appsettings.json  <  appsettings.local.json  <  environment variables  <  command line
  //
  // Two things to know about overrides:
  //   * Objects merge setting by setting, so naming one key under "Source" leaves the rest
  //     of "Source" alone.
  //   * A list REPLACES the shipped list rather than adding to it. If you set "UserFields",
  //     write all of them.
  //
  // Do not put a client secret here unless you must: this file is plaintext. Prefer
  //   aprimo-pm-export --save-credentials
  // which stores it encrypted with Windows DPAPI, outside this folder.

  "Aprimo": {
    // REQUIRED. The subdomain of your Aprimo URL: for https://acme.aprimo.com it is "acme".
    // The placeholder below is rejected on purpose, so this file cannot be used unedited.
    "Tenant": "your-tenant"

    // Only if your environment does not use the standard hosts (a sandbox, say):
    // "ApiBaseUrl": "https://your-host.example.com/api",
    // "TokenUrl": "https://your-host.example.com/login/connect/token"
  }

  // ---- Commonly changed settings. Uncomment, and add a comma after the block above. ----

  // ,"Throttle": { "RequestsPerSecond": 2 }

  // The server may cap the page size without saying so; the tool detects that and adapts,
  // but setting the size it will actually return avoids one wasted request per object.
  // ,"Source": { "Paging": { "PageSize": 250 } }

  // ,"Output": {
  //     "Directory": "./export",
  //     "FilePrefix": "aprimo-pm",
  //
  //     // Properties that hold user IDs in YOUR tenant, so --discover-fields writes a
  //     // user: column for them. This REPLACES the shipped list.
  //     "UserFields": [ "projectManager", "modifiedUser", "ownerId", "administratorId" ]
  //   }

  // Which objects a bare run exports: a comma-separated list of names from objects.json,
  // or "all". Run --list-objects to see them.
  // ,"Objects": "projects,activities"
}
